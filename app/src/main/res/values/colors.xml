<!-- Контейнер именованных ресурсов. Через R код обращается к строкам, цветам и другим ресурсам. -->
<resources>
    <!-- Именованный цвет. В игре используются стандартные цвета темы; эти цвета остались от шаблона Android Studio. -->
    <color
        name="black">#FF000000</color>
    <!-- Именованный цвет. В игре используются стандартные цвета темы; эти цвета остались от шаблона Android Studio. -->
    <color
        name="white">#FFFFFFFF</color>
</resources>
