<?xml version="1.0" encoding="utf-8"?>
<!-- Векторный флаг. width/height — размер изображения; viewportWidth/viewportHeight задают систему координат для фигур внутри. -->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="200dp"
    android:viewportWidth="300"
    android:viewportHeight="200">
    <!-- Часть рисунка флага. fillColor — цвет в формате #RRGGBB; pathData — контур: M перемещает точку, L рисует отрезок, h/v — горизонталь/вертикаль, a — дугу, z замыкает фигуру. -->
    <path
        android:fillColor="#009246"
        android:pathData="M0,0h100.0v200h-100.0z" />
    <!-- Часть рисунка флага. fillColor — цвет в формате #RRGGBB; pathData — контур: M перемещает точку, L рисует отрезок, h/v — горизонталь/вертикаль, a — дугу, z замыкает фигуру. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M100.0,0h100.0v200h-100.0z" />
    <!-- Часть рисунка флага. fillColor — цвет в формате #RRGGBB; pathData — контур: M перемещает точку, L рисует отрезок, h/v — горизонталь/вертикаль, a — дугу, z замыкает фигуру. -->
    <path
        android:fillColor="#CE2B37"
        android:pathData="M200.0,0h100.0v200h-100.0z" />
</vector>
