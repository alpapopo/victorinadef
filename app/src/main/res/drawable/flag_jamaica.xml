<?xml version="1.0" encoding="utf-8"?>
<!-- Векторный флаг. width/height — размер изображения; viewportWidth/viewportHeight задают систему координат для фигур внутри. -->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="200dp"
    android:viewportWidth="300"
    android:viewportHeight="200">
    <!-- Часть рисунка флага. fillColor — цвет в формате #RRGGBB; pathData — контур: M перемещает точку, L рисует отрезок, h/v — горизонталь/вертикаль, a — дугу, z замыкает фигуру. -->
    <path
        android:fillColor="#009B3A"
        android:pathData="M0,0h300v200h-300z" />
    <!-- Часть рисунка флага. fillColor — цвет в формате #RRGGBB; pathData — контур: M перемещает точку, L рисует отрезок, h/v — горизонталь/вертикаль, a — дугу, z замыкает фигуру. -->
    <path
        android:fillColor="#000000"
        android:pathData="M0,0L150,100L0,200zM300,0L150,100L300,200z" />
    <!-- Часть рисунка флага. fillColor — цвет в формате #RRGGBB; pathData — контур: M перемещает точку, L рисует отрезок, h/v — горизонталь/вертикаль, a — дугу, z замыкает фигуру. -->
    <path
        android:fillColor="#FED100"
        android:pathData="M0,0L18,0L300,188L300,200L282,200L0,12zM300,0L282,0L0,188L0,200L18,200L300,12z" />
</vector>
